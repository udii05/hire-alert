# --- Database ---
# PostgreSQL connection string for Prisma (Next.js frontend)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hire_alert?schema=public"

# --- NextAuth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="***REMOVED-AUTH-SECRET***"
AUTH_URL="http://localhost:3000"

# --- OAuth Providers ---
# Google: https://console.cloud.google.com/apis/credentials
#   Add redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# GitHub: https://github.com/settings/developers
#   Add callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- Backend (FastAPI) ---
# URL the frontend uses to reach the backend
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"
# Must match backend/.env BACKEND_API_KEY
BACKEND_API_KEY="***REMOVED-BACKEND-API-KEY***"

# --- Redis ---
REDIS_URL="redis://localhost:6379"
