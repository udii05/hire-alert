# Copy this file to backend/.env and fill in values.
# All variables are optional unless noted — defaults live in app/core/config.py.

# --- Database (required in production) ---
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5433/hire_alert"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5433/hire_alert"

# --- Redis ---
REDIS_URL="redis://localhost:6379/0"

# --- Auth (REQUIRED in production; app refuses to start with the default) ---
# Must match the frontend BACKEND_API_KEY.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BACKEND_API_KEY="backend-api-key-change-in-production"

# --- CORS: comma-separated list of allowed frontend origins ---
# Production example: https://hire-alert.vercel.app
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- App URL (used in email links) ---
APP_URL="http://localhost:3000"

# --- Email alerts (optional) ---
EMAIL_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Hire Alert <noreply@hire-alert.com>"

# --- Kaggle API (optional; HTML fallback used otherwise) ---
KAGGLE_USERNAME=""
KAGGLE_KEY=""

# --- Tuning (optional) ---
# HIGH/MEDIUM priority boundaries in days until deadline
HIGH_PRIORITY_DAYS=7
MEDIUM_PRIORITY_DAYS=15
# Assumed deadline when a source provides none
DEFAULT_DEADLINE_DAYS=30
# Background refresh cadence (hours)
REFRESH_INTERVAL_HOURS=24
